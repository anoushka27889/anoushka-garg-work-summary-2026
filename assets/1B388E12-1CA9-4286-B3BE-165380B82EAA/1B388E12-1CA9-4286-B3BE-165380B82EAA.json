47819519}},{"text":"Have you ever explored a space?","targetRectangle":{"y":1998.1947021484375,"x":-602.14617919921875,"width":865.82564526796341,"height":223.20000147819519}},{"text":"Lumen_Glyptoteket_Full.mov","targetRectangle":{"y":5.949462890625,"x":-7.62451171875,"width":1935.2490234375,"height":1088.57763671875}},{"text":"If you’ve explored a space than you know how to use it","targetRectangle":{"y":2357.61572265625,"x":-602.14617919921875,"width":1978.1532244980335,"height":223.20000147819519}},{"text":"Doing a thing with people that feels so human — building it off of something that people have spent their whole life doing","targetRectangle":{"y":2798.0849609375,"x":-931.6153564453125,"width":1986.7050409503281,"height":322.40000295639038}},{"text":"Video Prototype","targetRectangle":{"y":1018.70361328125,"x":31.160036087036133,"width":221.09707050025463,"height":42}},{"text":"People cannot think outside of mobile phones as a solution…","targetRectangle":{"y":2503.731201171875,"x":1807.3909912109375,"width":1812.2306852973998,"height":223.20000147819519}},{"text":"Museums + retail","targetRectangle":{"y":1270.4842529296875,"x":-2513.4130859375,"width":807.73525459691882,"height":124}},{"text":"By default nothing is shared in AR","targetRectangle":{"y":1505.2593994140625,"x":616.58447265625,"width":1608.638712503016,"height":124}},{"text":"Low floor, high ceiling — wide door","targetRectangle":{"y":1703.6594023704529,"x":616.58447265625,"width":1663.810099221766,"height":124}},{"text":"If someone has the projector, you don’t need to learn anything","targetRectangle":{"y":1902.0594053268433,"x":616.58447265625,"width":1871.2283611707389,"height":223.20000147819519}},{"text":"Highlight the fact that it’s shared","targetRectangle":{"y":1220.4842529296875,"x":-602.14617919921875,"width":832.63630942255259,"height":223.20000147819519}}],"baseLayer":{"animations":[],"initialState":{"affineTransform":[1,0,0,1,0,0],"masksToBounds":false,"rotation":0,"scale":1,"posit